# SkillSync Environment Configuration
# Copy this file to .env and configure your values

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/skillsync?schema=public"

# Backend Server Port (Port 5001 avoids macOS AirPlay Receiver conflict on 5000)
PORT=5001

# Client Application URL (for CORS)
CLIENT_URL="http://localhost:5173"
