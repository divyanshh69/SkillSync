# SkillSync Backend Environment Configuration
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/skillsync?schema=public"
PORT=5001
CLIENT_URL="http://localhost:5173"

# Google Gemini AI Configuration
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3-flash-preview"

# Optional: GitHub Personal Access Token to increase API rate limits (60 req/hr -> 5,000 req/hr)
# Not required for public repository analysis
GITHUB_TOKEN=""
